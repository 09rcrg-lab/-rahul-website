{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "rahul-live-api",

  "main": "worker.js",

  "compatibility_date": "2026-08-01",

  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rahulsocialhub-db",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE"
    }
  ]
}